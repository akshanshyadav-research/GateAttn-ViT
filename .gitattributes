*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.csv text eol=lf
*.ipynb text eol=lf
*.json text eol=lf
*.json.gz binary
*.png binary
*.jpg binary
*.pdf binary
*.npz binary

# Complete byte-exact source archive, including data and paper.
archive/originals/** filter=lfs diff=lfs merge=lfs -text
local_assets/** filter=lfs diff=lfs merge=lfs -text
# Generated run metadata stays readable; large outputs use LFS.
runs/**/*.ipynb filter=lfs diff=lfs merge=lfs -text
runs/**/*.png filter=lfs diff=lfs merge=lfs -text
runs/**/*.jpg filter=lfs diff=lfs merge=lfs -text
runs/**/*.pdf filter=lfs diff=lfs merge=lfs -text
runs/**/*.npz filter=lfs diff=lfs merge=lfs -text
